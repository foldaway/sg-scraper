{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sg-scraper",
  // Set this to today's date
  "compatibility_date": "2026-06-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.ts",
  "triggers": {
    "crons": ["0 0 * * sat"]
  },
  "browser": {
    "binding": "BROWSER"
  },
  "r2_buckets": [
    {
      "binding": "OUTPUT_BUCKET",
      "bucket_name": "sg-scraper-data"
    }
  ],
  "vars": { "TIER": "development" },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "env": {
    "production": {
      "vars": {
        "TIER": "production"
      },
      "browser": {
        "binding": "BROWSER"
      },
      "r2_buckets": [
        {
          "binding": "OUTPUT_BUCKET",
          "bucket_name": "sg-scraper-data"
        }
      ],
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    }
  }
}
