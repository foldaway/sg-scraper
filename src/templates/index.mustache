<!doctype html>
<html lang="en">
  <head>
    <title>sg-scraper</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <style>
      html {
        font-family: sans-serif;
      }
    </style>
  </head>

  <body>
    <h1>sg-scraper</h1>

    <p>Scripts to scrape metadata of places in Singapore.</p>

    <section>
      <h2>Generated Files</h2>

      <ul>
        {{#files}}
          <li>
            <a href="{{.}}">{{.}}</a>
          </li>
        {{/files}}
      </ul>
    </section>

    <p>
      Generated
      <time datetime="{{generatedTime.isoString}}">{{generatedTime.displayText}}</time>
      on
      <span>{{osInfo.platform}}/{{osInfo.arch}}</span>
    </p>
  </body>
</html>
